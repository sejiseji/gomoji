{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gomojingo/content_pack.schema.json",
  "title": "ごもじンゴ Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "id_range",
    "entry_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "pack_id": {
      "type": "string",
      "pattern": "^pack_[0-9]{3}$"
    },
    "id_range": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^GMG[0-9]{4}$"
        },
        {
          "type": "string",
          "pattern": "^GMG[0-9]{4}$"
        }
      ],
      "items": false
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "entry.schema.json"
      }
    }
  }
}
